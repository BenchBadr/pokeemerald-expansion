script Amphi_StarterNickname {
    setvar(VAR_0x8014, 1)
    setflag(FLAG_SYS_POKEMON_GET)
    msgbox(format("Would you like to give {STR_VAR_1} a nickname?"), MSGBOX_YESNO)
    if (var(VAR_RESULT)==1){
        if (var(VAR_RESULT)==1){
            call(Common_EventScript_NameReceivedPartyMon)
        }
    }

    applymovement(2, moves(
        walk_down 
        face_right 
    ))

    applymovement(3, moves(
        face_left
    ))

    applymovement(6, moves(
        enter_pokeball
    ))

    applymovement(7, moves(
        enter_pokeball
    ))

    applymovement(8, moves(
        enter_pokeball
    ))

    waitmovement(0)

    setvar(VAR_0x8014, 0)
    setspeaker("Pr. Sycamore")
    msgbox(format("Now that you have your partner, here is a Pokédex. We hope that you fill as many pages as possible. That data will be valuable for our researches."))


    // setflag(FLAG_SYS_POKEDEX_GET)
    setflag(FLAG_SYS_PHONE_GET)
    setflag(FLAG_IS_CHOOSING_MON)

    closemessage
    release 
    end
}

script Amphi_Policeman {
    lock 
    msgbox(format("Dummy text."))
    release 
    end
}

script Arr2_ForceChooseStarter {
    lock
    if (!flag(FLAG_SYS_POKEMON_GET)) 
    {
        msgbox(format("Host"))
        msgbox(format("Where are you going?"))
        
        applymovement(OBJ_EVENT_ID_PLAYER, moves(
            walk_right * 1
        ))

    }
    release 
    end 

}