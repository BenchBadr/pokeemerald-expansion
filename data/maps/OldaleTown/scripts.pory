mapscripts OldaleTown_MapScripts {}

script ScraftyBeers_Sign {
	msgbox(format("Scrafty Beers. \nIndependent brewery. \pHandcrafted Beers, brewed tough, served cold."), MSGBOX_SIGN)
	closemessage
	end
}


script ManTest {
	setvar(0x8014, 1)
	msgbox(format("Just a little yesno test"))

	setvar(VAR_0x8004, 5)
	callnative(Script_AddTrainerPointsAnim)
	waitbuttonpress
	callnative(Script_HideRankDisplay)

	msgbox(format("Cool eh!"))
	setvar(0x8014, 0)
	closemessage
	end
}

script BattleZone1_Matchmaking {
    lock
    faceplayer
	setvar(0x8014, 1)
	msgbox(format("Do you want to find an opponent?"), MSGBOX_YESNO)

	closemessage

	if (!var(VAR_RESULT)) { return }

	setflag(0x4E) // disable follower
	hidefollower


	applymovement(OBJ_EVENT_ID_PLAYER, moves(
		walk_left * 2
		walk_up * 2
		face_down
	))
	waitmovement(0)

	setflag(0x4D)

	setvar(0x8014, 0)

	trainerbattle_no_intro(TRAINER_SAWYER_1, format("Crushed like a pebble..."))

	special(HealPlayerParty)


	setvar(0x8014, 1) // dark mode again


	if (var(VAR_RESULT) == B_OUTCOME_WON) {
        msgbox(format("Congratulations on your victory! Your rank is being updated..."))

		setvar(VAR_0x8004, 5)


    } else {
        msgbox(format("You lost your battle. Your rank is being updated..."))

		setvar(VAR_0x8004, -5)
    }

	callnative(Script_AddTrainerPointsAnim)
	waitbuttonpress
	callnative(Script_HideRankDisplay)

	setvar(0x8014, 0) 
	clearflag(0x4E) // enable follower again
	clearflag(0x4D) // enable whiteout again
    release
    end
}