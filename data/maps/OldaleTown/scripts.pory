mapscripts OldaleTown_MapScripts {}

// IN THE BATTLE ZONE

script ManTest {
	lock
	faceplayer

	msgbox(format("Welcome to the Battle Zone! Do you need any explanation ?"))

	// dynmultichoice(left, top, ignoreBPress, maxBeforeScroll, initialSelected, callbacks, option1,...
	dynmultichoice(0, 0, FALSE, 3, 0, DYN_MULTICHOICE_CB_NONE, "What are ranks", "What is this place", "Add Points","Remove Points", "No thanks")
	switch (var(VAR_RESULT)) {
		case 0:
			msgbox(format("There are 5 ranks in the PWC."))
		case 1: 
			msgbox(format("This place is what we call a Battle Zone."))
		case 2: 
			setvar(0x8004, 5)
			callnative(Script_AddTrainerPointsAnim)
			delay(120)
			waitbuttonpress
			callnative(Script_HideRankDisplay)
		case 3: 
			setvar(0x8004, -5)
			callnative(Script_AddTrainerPointsAnim)
			delay(120)
			waitbuttonpress
			callnative(Script_HideRankDisplay)
	}

	closemessage
	end
}

script BattleZone1_Matchmaking {
    lock
    faceplayer

	setvar(0x8014, 1) // enable dark sign

	msgbox(format("Do you want to find an opponent?"), MSGBOX_YESNO)
	closemessage

	if (!var(VAR_RESULT)) { return }

	// get trainer

		hidefollower
		

		msgbox(format("Matchmaking in progress... {PAUSE 10} ... {PAUSE 10} ... "))


		callnative(Script_SetupRandomOpponent)

		msgbox("An opponent has been found!\nGet ready to battle {STR_VAR_1}!")


		

	// Party selection 

		special(SavePlayerParty)
		setvar(VAR_0x8006, 1) // we'll use this to toggle preview
		setvar(VAR_0x8005, 3) // number of pokemon

		special(ChoosePartyForBattleFrontier)
		// waitstate



	// Movement and setup

		applymovement(OBJ_EVENT_ID_PLAYER, moves(
			walk_left * 2
			walk_up * 2
			face_down
		))
		waitmovement(0)


		setflag(0x4D) // for whiteout
		setvar(0x8014, 0) // for dark mode

		special(HealPlayerParty)



	// Battle settings

		frontier_set(FRONTIER_DATA_SELECTED_MON_ORDER)
		frontier_setpartyorder(3)

	// Battle	
		callnative(Script_LoadOpponentSpeech)
		setspeaker("{STR_VAR_1}")
		msgbox(format("{STR_VAR_2}"))

		trainerbattle_no_intro(TRAINER_NONE, format("{STR_VAR_3}"))


	// heal party after
	special(HealPlayerParty)


	setvar(0x8014, 1) // dark mode again


	if (var(VAR_RESULT) == B_OUTCOME_WON) {
        msgbox(format("Congratulations on your victory! Your rank is being updated..."))

		setvar(VAR_0x8004, 5)


    } else {
        msgbox(format("You lost your battle. Your rank is being updated..."))

		setvar(VAR_0x8004, -5)
    }

	callnative(Script_AddTrainerPointsAnim)
	delay(120)
	waitbuttonpress
	callnative(Script_HideRankDisplay)

	special(LoadPlayerParty) // bring back the team

	setvar(0x8014, 0) // end dark mode
	clearflag(0x4E) // enable follower again
	clearflag(0x4D) // enable whiteout again
    release
    end
}





