}

script Arr2_BarLady {
	lock 
	faceplayer

	if (flag(FLAG_RECEIVED_TM_SHOCK_WAVE)) 
	{
		msgbox(format("I am glad I was in the bar that day. My life would have been very different otherwise."))
		release 
		end
	}

	msgbox(format("You know, me and my husband met in this very bar. We met under very special circumstances."))
	applymovement(16, moves(
		emote_exclamation_mark
		jump_in_place_right 
		face_left
	))
	waitmovement(0)

	special(SpawnCameraObject)
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left * 2))
	msgbox(format("No! Don't tell him!"))
	applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_right * 2))
	msgbox(format("Do you want to know ?"), MSGBOX_YESNO)
	if (var(VAR_RESULT)) {
		msgbox(format("Well, he had too much wine that day. He was so drunk people were gathering around him thinking he was dead."))

		msgbox(format("Then I came, ordered by Pokémon to use {COLOR RED}{SHADOW LIGHT_RED}Shock Wave{COLOR DARK_GRAY}{SHADOW LIGHT_GRAY}, and he woke up abruptly."))

		msgbox(format("He looked at me and said, 'Are you an angel?' I never let him live that down."))

		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left * 2))
		waitmovement(0)
		msgbox(format("I am so embarassed!"))
		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_right * 2))

		msgbox(format("And well... here we are, years later!"))

		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_left * 2))
		waitmovement(0)

		applymovement(16, moves(
			face_right
			emote_heart
		))

		msgbox(format("I am glad a met you."))

		applymovement(OBJ_EVENT_ID_CAMERA, moves(walk_fast_right * 2))
		waitmovement(0)

		applymovement(17, moves(
			face_left 
			emote_heart
		))
		waitmovement(0)

		msgbox(format("Me too... Me too..."))

		faceplayer
		msgbox(format("Oh. I am rambling again. Here's a little thank you for listening to me."))
		giveitem(ITEM_TM_SHOCK_WAVE) 
		setflag(FLAG_RECEIVED_TM_SHOCK_WAVE)
	}

	special(RemoveCameraObject)
	release 
	end
}